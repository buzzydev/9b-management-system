generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────── Enums ─────────────

enum Role {
  ADMIN
  TEACHER
  CLASS_LEADER
  ASSISTANT
}

enum StudentStatus {
  ACTIVE
  ARCHIVED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
  ESCAPED // «Qochib ketdi» — faqat administrator tasdiqlagan EscapeRecord orqali qo'yiladi
}

enum AttendanceSource {
  MANUAL
  QR
}

enum Priority {
  NORMAL
  IMPORTANT
  URGENT
}

enum EventType {
  EXAM
  TEST
  DEADLINE
  SCHOOL_EVENT
  MEETING
  HOLIDAY
  ANNOUNCEMENT
}

enum NotificationType {
  ATTENDANCE_SAVED
  STUDENT_ABSENT
  HOMEWORK_ASSIGNED
  HOMEWORK_DEADLINE
  NEW_ANNOUNCEMENT
  GRADE_UPDATED
  TIMETABLE_CHANGED
  UPCOMING_EXAM
  MESSAGE
  SYSTEM
}

enum AchievementType {
  BEST_ATTENDANCE
  TOP_PERFORMANCE
  HOMEWORK_COMPLETION
  MOST_IMPROVED
  PARTICIPATION
}

enum DutyStatus {
  ASSIGNED // avtomatik yoki qo'lda belgilangan, hali tasdiqlanmagan
  DONE // ikkala vazifa ham bajarilgan
  MISSED // kelmagan / bajarmagan — navbati hisobga olinmaydi, keyingi kunga qoladi
}

enum BackupStatus {
  PENDING
  SUCCESS
  FAILED
}

// ───────────── Users ─────────────

model User {
  id                 String    @id @default(cuid())
  username           String    @unique
  passwordHash       String
  fullName           String
  email              String?
  phone              String?
  avatarUrl          String?
  role               Role      @default(ASSISTANT)
  isActive           Boolean   @default(true)
  mustChangePassword Boolean   @default(false)
  passwordChangedAt  DateTime  @default(now())
  failedLogins       Int       @default(0)
  lockedUntil        DateTime?
  lastLoginAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  settings          UserSettings?
  notifications     Notification[]
  threadMembers     ThreadMember[]
  messages          Message[]
  threadsCreated    Thread[]
  attendance        Attendance[]
  qrSessions        QrSession[]
  homework          Homework[]
  submissions       HomeworkSubmission[]
  grades            Grade[]
  gradeChanges      GradeHistory[]
  events            CalendarEvent[]
  announcements     Announcement[]
  announcementReads AnnouncementRead[]
  achievements      Achievement[]
  escapesCreated    EscapeRecord[]
  notes             TeacherNote[]
  backups           BackupRecord[]

  @@index([role, isActive])
}

model UserSettings {
  id                  String   @id @default(cuid())
  userId              String   @unique
  theme               String   @default("system")
  language            String   @default("uz")
  notifyAttendance    Boolean  @default(true)
  notifyHomework      Boolean  @default(true)
  notifyAnnouncements Boolean  @default(true)
  notifyGrades        Boolean  @default(true)
  notifyTimetable     Boolean  @default(true)
  notifyEvents        Boolean  @default(true)
  notifyMessages      Boolean  @default(true)
  hiddenWidgets       String[] @default([])
  updatedAt           DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SystemSettings {
  id                     String   @id @default("singleton")
  schoolName             String   @default("9-B Maktab")
  academicYear           String   @default("2026-2027")
  defaultLanguage        String   @default("uz")
  gradeMin               Float    @default(1)
  gradeMax               Float    @default(5)
  gradePassing           Float    @default(3)
  gradeStep              Float    @default(1)
  attendanceAlertPercent Int      @default(85)
  qrTtlMinutes           Int      @default(10)
  qrLateAfterMinutes     Int      @default(10)
  updatedAt              DateTime @updatedAt
}

// ───────────── Class & Students ─────────────

model Class {
  id           String   @id @default(cuid())
  name         String   @unique
  academicYear String?
  createdAt    DateTime @default(now())

  students   Student[]
  attendance Attendance[]
  timetable  Timetable[]
  homework   Homework[]
  qrSessions QrSession[]
  events     CalendarEvent[]
}

model Student {
  id          String        @id @default(cuid())
  studentCode String        @unique
  classId     String
  fullName    String
  photoUrl    String?
  dateOfBirth DateTime?     @db.Date
  phone       String?
  parentPhone String?
  enrolledAt  DateTime      @default(now()) @db.Date
  notes       String?
  status      StudentStatus @default(ACTIVE)
  archivedAt  DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  class        Class                @relation(fields: [classId], references: [id], onDelete: Restrict)
  attendance   Attendance[]
  grades       Grade[]
  submissions  HomeworkSubmission[]
  achievements Achievement[]
  escapes      EscapeRecord[]
  dutyMember   DutyMember?
  dutyTurns    DutyAssignment[]
  teacherNotes TeacherNote[]

  @@index([classId, status])
  @@index([fullName])
}

model TeacherNote {
  id        String   @id @default(cuid())
  studentId String
  authorId  String?
  body      String
  createdAt DateTime @default(now())

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  author  User?   @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([studentId, createdAt])
}

// ───────────── Attendance ─────────────

model Attendance {
  id          String           @id @default(cuid())
  studentId   String
  classId     String
  date        DateTime         @db.Date
  status      AttendanceStatus
  source      AttendanceSource @default(MANUAL)
  note        String?
  markedById  String?
  qrSessionId String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  student   Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  class     Class      @relation(fields: [classId], references: [id], onDelete: Restrict)
  markedBy  User?      @relation(fields: [markedById], references: [id], onDelete: SetNull)
  qrSession QrSession? @relation(fields: [qrSessionId], references: [id], onDelete: SetNull)

  @@unique([studentId, date])
  @@index([date])
  @@index([classId, date, status])
}

model QrSession {
  id          String    @id @default(cuid())
  tokenHash   String    @unique
  classId     String
  date        DateTime  @db.Date
  createdById String?
  expiresAt   DateTime
  lateAfter   DateTime?
  closedAt    DateTime?
  scans       Int       @default(0)
  createdAt   DateTime  @default(now())

  class      Class        @relation(fields: [classId], references: [id], onDelete: Cascade)
  createdBy  User?        @relation(fields: [createdById], references: [id], onDelete: SetNull)
  attendance Attendance[]

  @@index([createdAt])
}

// ───────────── Academics ─────────────

model Subject {
  id        String   @id @default(cuid())
  name      String   @unique
  shortName String?
  createdAt DateTime @default(now())

  timetable Timetable[]
  homework  Homework[]
  grades    Grade[]
}

model Timetable {
  id           String   @id @default(cuid())
  classId      String
  weekday      Int // 1 = Dushanba … 6 = Shanba
  lessonNumber Int
  subjectId    String
  teacherName  String
  room         String?
  startTime    String // HH:mm
  endTime      String // HH:mm
  updatedAt    DateTime @updatedAt

  class   Class   @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Restrict)

  @@unique([classId, weekday, lessonNumber])
  @@index([classId, weekday])
}

model Homework {
  id          String   @id @default(cuid())
  classId     String
  subjectId   String
  title       String
  description String?
  deadline    DateTime
  attachments Json?
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  class       Class                @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject     Subject              @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  createdBy   User?                @relation(fields: [createdById], references: [id], onDelete: SetNull)
  submissions HomeworkSubmission[]

  @@index([classId, deadline])
}

model HomeworkSubmission {
  id          String    @id @default(cuid())
  homeworkId  String
  studentId   String
  completed   Boolean   @default(false)
  completedAt DateTime?
  note        String?
  markedById  String?
  updatedAt   DateTime  @updatedAt

  homework Homework @relation(fields: [homeworkId], references: [id], onDelete: Cascade)
  student  Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  markedBy User?    @relation(fields: [markedById], references: [id], onDelete: SetNull)

  @@unique([homeworkId, studentId])
  @@index([studentId])
}

model Grade {
  id          String   @id @default(cuid())
  studentId   String
  subjectId   String
  value       Float
  type        String   @default("CLASSWORK") // CLASSWORK | HOMEWORK | TEST | EXAM | QUARTER
  date        DateTime @db.Date
  comment     String?
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  student   Student        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subject   Subject        @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  createdBy User?          @relation(fields: [createdById], references: [id], onDelete: SetNull)
  history   GradeHistory[]

  @@index([studentId, subjectId])
  @@index([date])
}

model GradeHistory {
  id          String   @id @default(cuid())
  gradeId     String
  action      String // CREATE | UPDATE
  oldValue    Float?
  newValue    Float
  comment     String?
  changedById String?
  createdAt   DateTime @default(now())

  grade     Grade @relation(fields: [gradeId], references: [id], onDelete: Cascade)
  changedBy User? @relation(fields: [changedById], references: [id], onDelete: SetNull)

  @@index([gradeId, createdAt])
}

// ───────────── Calendar / Announcements ─────────────

model CalendarEvent {
  id              String    @id @default(cuid())
  classId         String?
  title           String
  description     String?
  type            EventType @default(SCHOOL_EVENT)
  startsAt        DateTime
  endsAt          DateTime?
  allDay          Boolean   @default(false)
  reminderMinutes Int?
  createdById     String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  class     Class? @relation(fields: [classId], references: [id], onDelete: SetNull)
  createdBy User?  @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([startsAt])
  @@index([type, startsAt])
}

model Announcement {
  id          String   @id @default(cuid())
  title       String
  body        String
  priority    Priority @default(NORMAL)
  pinned      Boolean  @default(false)
  publishAt   DateTime @default(now())
  attachments Json?
  authorId    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  author User?              @relation(fields: [authorId], references: [id], onDelete: SetNull)
  reads  AnnouncementRead[]

  @@index([pinned, publishAt])
}

model AnnouncementRead {
  announcementId String
  userId         String
  readAt         DateTime @default(now())

  announcement Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([announcementId, userId])
}

// ───────────── Notifications / Messages ─────────────

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  body      String?
  link      String?
  dedupeKey String?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dedupeKey])
  @@index([userId, readAt, createdAt])
}

model Thread {
  id          String   @id @default(cuid())
  title       String?
  isGroup     Boolean  @default(false)
  dmKey       String?  @unique
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now())

  createdBy User?          @relation(fields: [createdById], references: [id], onDelete: SetNull)
  members   ThreadMember[]
  messages  Message[]

  @@index([updatedAt])
}

model ThreadMember {
  threadId   String
  userId     String
  lastReadAt DateTime?
  joinedAt   DateTime  @default(now())

  thread Thread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([threadId, userId])
  @@index([userId])
}

model Message {
  id        String   @id @default(cuid())
  threadId  String
  senderId  String?
  body      String
  createdAt DateTime @default(now())

  thread Thread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  sender User?  @relation(fields: [senderId], references: [id], onDelete: SetNull)

  @@index([threadId, createdAt])
}

// ───────────── Achievements ─────────────

model Achievement {
  id          String          @id @default(cuid())
  studentId   String
  type        AchievementType
  title       String
  description String?
  score       Float           @default(0)
  period      String?
  awardedById String?
  awardedAt   DateTime        @default(now())

  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  awardedBy User?   @relation(fields: [awardedById], references: [id], onDelete: SetNull)

  @@index([studentId])
  @@index([type, awardedAt])
}

// ───────────── Audit / Backup ─────────────

// Append-only: UPDATE/DELETE bazadagi trigger orqali bloklanadi (scripts/bootstrap.mjs).
// userId ataylab FK emas — foydalanuvchi o'chirilsa ham jurnal saqlanadi.
model ActivityLog {
  id          String   @id @default(cuid())
  userId      String?
  userName    String
  role        Role?
  action      String
  category    String
  description String
  entityType  String?
  entityId    String?
  ip          String?
  userAgent   String?
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([category, createdAt])
  @@index([userId, createdAt])
}

model BackupRecord {
  id          String       @id @default(cuid())
  filename    String
  storagePath String
  sizeBytes   Int          @default(0)
  checksum    String?
  data        Bytes? // gzip nusxa (Postgres'da ham saqlanadi — Volume bo'lmasa ham yo'qolmaydi)
  recordCount Int          @default(0)
  status      BackupStatus @default(PENDING)
  error       String?
  createdById String?
  createdAt   DateTime     @default(now())
  restoredAt  DateTime?

  createdBy User? @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([createdAt])
}

/// «Qochib ketdi» qaydlari tarixi. Faqat qo'shiladi (o'zgartirish/o'chirish API'si yo'q).
/// Ism va muallif nomi nusxa sifatida saqlanadi: o'quvchi/foydalanuvchi o'chirilsa ham tarix yo'qolmaydi.
model EscapeRecord {
  id            String   @id @default(cuid())
  studentId     String?
  studentName   String
  date          DateTime @db.Date // qochib ketgan sana
  hours         Float // necha soatga ketgani
  reason        String // administrator izohi (sabab va vaqt)
  createdById   String?
  createdByName String
  createdAt     DateTime @default(now()) // qayd kiritilgan vaqt

  student   Student? @relation(fields: [studentId], references: [id], onDelete: SetNull)
  createdBy User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([date])
  @@index([studentId, date])
  @@index([createdAt])
}

// ───────────── Navbatchilar ─────────────

/// Navbat ro'yxati: har bir faol o'quvchi uchun bitta yozuv. `position` — alifbo (yoki administrator belgilagan) tartib.
model DutyMember {
  id           String   @id @default(cuid())
  studentId    String   @unique
  position     Int
  /// Navbatchilikka qo'shilganda mavjud aylanishga tenglash uchun boshlang'ich hisob (adolat uchun)
  baseline     Int      @default(0)
  enabled      Boolean  @default(true)
  /// O'quvchi arxivlanganda tizim avtomatik o'chirgan bo'lsa true (qaytarilganda avtomatik yoqiladi)
  autoDisabled Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([enabled, position])
}

/// Bitta qatorli sozlama (id = "singleton")
model DutySettings {
  id        String   @id @default("singleton")
  /// Navbatchilik bo'ladigan hafta kunlari (ISO: 1 = dushanba … 7 = yakshanba)
  weekdays  Int[]    @default([1, 2, 3, 4, 5, 6])
  /// Tizim ishga tushgan sana — shundan oldingi kunlar uchun navbatchi tayinlanmaydi
  startedOn DateTime? @db.Date
  updatedAt DateTime @updatedAt
}

/// Kunlik navbatchi: har sana uchun aynan 2 ta (slot 1 va 2). Sana + slot noyob — kun ichida takror belgilanmaydi.
model DutyAssignment {
  id           String     @id @default(cuid())
  date         DateTime   @db.Date
  slot         Int // 1 yoki 2
  studentId    String?
  studentName  String // arxiv uchun nusxa (o'quvchi o'chirilsa ham tarix saqlanadi)
  status       DutyStatus @default(ASSIGNED)
  manual       Boolean    @default(false) // administrator qo'lda almashtirgan
  replacedName String? // kim o'rniga qo'yilgani
  note         String?
  markedById   String?
  markedByName String?
  markedAt     DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  student Student? @relation(fields: [studentId], references: [id], onDelete: SetNull)

  @@unique([date, slot])
  @@index([studentId, status])
  @@index([date])
}
