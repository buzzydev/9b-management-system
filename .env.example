# ===== Majburiy =====
# PostgreSQL ulanish manzili (Railway'da Postgres plugin avtomatik beradi)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ninebee?schema=public"

# Neon (Railway orqali) uchun: DATABASE_URL — pooled (-pooler, ?sslmode=require&pgbouncer=true),
# DIRECT_URL — pooler'siz (faqat migratsiya/jadval yaratish uchun; bo'lmasa DATABASE_URL ishlatiladi)
# DIRECT_URL=""

# Sessiya imzosi uchun maxfiy kalit (kamida 32 belgi).
# Yaratish: openssl rand -base64 48
AUTH_SECRET=""

# ===== Birinchi Admin (faqat hisob yo'q bo'lganda bir marta yaratiladi) =====
ADMIN_USERNAME="admin"
ADMIN_PASSWORD=""          # kamida 10 belgi
ADMIN_FULL_NAME="Administrator"

# ===== Ixtiyoriy =====
CLASS_NAME="9-B"
SCHOOL_NAME="9-B Maktab"
APP_TIMEZONE="Asia/Tashkent"
SESSION_HOURS="8"

# Doimiy fayl saqlash (yuklangan fayllar + zaxira nusxalar).
# Railway'da Volume'ni /data ga ulang va shu yerga /data deb yozing.
STORAGE_DIR="./storage"

# Proxy ortida ishlaganda ishonchli IP sarlavhasi (Railway: x-forwarded-for)
TRUST_PROXY="true"

# Ochiq (mehmon) ko'rish rejimi. "true" (standart): havolani bilgan har kim login'siz saytni ko'ra oladi —
# faqat o'qish va maxfiy bo'lmagan ma'lumotlar (jadval, uy vazifa, e'lon, kalendar, yutuqlar, o'quvchilar ismi).
# Davomat, baho, hisobot, xabar, jurnal va barcha boshqaruv funksiyalari faqat tizimga kirgan xodimlarga.
# To'liq yopish uchun: PUBLIC_ACCESS="false"
PUBLIC_ACCESS="true"
